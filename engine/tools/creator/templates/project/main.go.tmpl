// {{.Name}} — приложение на Hexago.
package main

import (
	"hexago/ui/app"
	"hexago/ui/text"
	"hexago/ui/widgets"
)

func main() {
	app.Run(widgets.App{
		Title: "{{.Name}}",
		Home:  HomePage{},
	})
}

// HomePage — стартовый экран приложения. Это свой виджет: тип со встроенным
// widgets.Base и методом Build, который описывает, из чего экран состоит.
type HomePage struct {
	widgets.Base
}

func (HomePage) Build(ctx widgets.BuildContext) widgets.Widget {
	return widgets.Center{
		Child: widgets.Text{
			Data:  "hexago",
			Style: text.Style{FontSize: 32, FontWeight: text.Bold},
		},
	}
}
