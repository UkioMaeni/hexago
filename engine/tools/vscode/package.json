{
  "name": "hexago",
  "displayName": "Hexago",
  "description": "Приложения на Hexago: создание и запуск проектов, действия с виджетами — обернуть, удалить, поменять местами.",
  "version": "0.3.2",
  "publisher": "hexago",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:go",
    "workspaceContains:go.mod",
    "onStartupFinished",
    "onDebugResolve:hexago",
    "onDebugDynamicConfigurations:hexago",
    "onDebugInitialConfigurations"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "hexago.selectSdk",
        "title": "Указать путь к SDK",
        "category": "Hexago"
      },
      {
        "command": "hexago.createProject",
        "title": "Создать проект",
        "category": "Hexago"
      },
      {
        "command": "hexago.run",
        "title": "Запустить на устройстве",
        "category": "Hexago",
        "icon": "$(play)"
      },
      {
        "command": "hexago.selectDevice",
        "title": "Выбрать устройство",
        "category": "Hexago",
        "icon": "$(device-mobile)"
      },
      {
        "command": "hexago.doctor",
        "title": "Проверить окружение",
        "category": "Hexago"
      },
      {
        "command": "hexago.widgetActions",
        "title": "Действия с виджетом…",
        "category": "Hexago"
      }
    ],
    "debuggers": [
      {
        "type": "hexago",
        "label": "Hexago",
        "languages": [
          "go"
        ],
        "configurationAttributes": {
          "launch": {
            "properties": {
              "device": {
                "type": "string",
                "description": "Где запускать: серийный номер, имя устройства или эмулятора (выключенный эмулятор запустится). Пусто — устройство, выбранное в строке состояния."
              },
              "cwd": {
                "type": "string",
                "description": "Папка проекта Hexago. Пусто — открытая папка.",
                "default": "${workspaceFolder}"
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "name": "Hexago",
            "type": "hexago",
            "request": "launch"
          }
        ],
        "configurationSnippets": [
          {
            "label": "Hexago: запуск на устройстве",
            "description": "Собрать и запустить приложение (hexago run)",
            "body": {
              "name": "Hexago",
              "type": "hexago",
              "request": "launch"
            }
          },
          {
            "label": "Hexago: запуск на конкретном эмуляторе",
            "body": {
              "name": "Hexago (${1:Pixel_7})",
              "type": "hexago",
              "request": "launch",
              "device": "${1:Pixel_7}"
            }
          }
        ]
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "hexago.widgetActions",
          "when": "editorLangId == go",
          "group": "1_modification@0"
        }
      ],
      "commandPalette": [
        {
          "command": "hexago.widgetActions",
          "when": "editorLangId == go"
        }
      ]
    },
    "keybindings": [
      {
        "command": "hexago.widgetActions",
        "key": "ctrl+alt+w",
        "mac": "cmd+alt+w",
        "when": "editorLangId == go"
      }
    ],
    "configuration": {
      "title": "Hexago",
      "properties": {
        "hexago.sdkPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Папка движка Hexago (в ней go.mod модуля hexago). Пусто — искать команду hexago в PATH."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "package": "vsce package --skip-license --allow-missing-repository -o hexago.vsix"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "^3.2.0",
    "typescript": "^5.6.0"
  }
}
